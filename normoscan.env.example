# === NormoScan ENV — заполненный пример ===
# Скопируйте в .env и поправьте только то, что помечено <-- ПРОВЕРИТЬ

# --- App ---
APP_ENV=development
SECRET_KEY=change-me-super-secret          # в проде: длинная случайная строка
API_HOST=0.0.0.0                            # ВАЖНО: API должен слушать 0.0.0.0,
API_PORT=8502                               # иначе фронт/докер его не увидит
FRONTEND_PORT=8501

# --- Database ---
# dev: sqlite. prod: postgres (раскомментировать вторую строку)
DATABASE_URL=sqlite:///./normoscan.db
# DATABASE_URL=postgresql+psycopg://normoscan:normoscan@postgres:5432/normoscan

# --- Redis / Celery ---
# Если приложение в docker — замените localhost на имя сервиса (redis).
# ВАЖНО: если пайплайн проверки идёт через Celery, а Redis не запущен —
# проверка «молча не запускается» (задача падает в очередь и висит).
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Vector DB ---
# dev без docker: qdrant на localhost (или VECTOR_DB=memory для быстрой проверки)
VECTOR_DB=qdrant
QDRANT_URL=http://localhost:6333            # в docker: http://qdrant:6333
QDRANT_API_KEY=
MILVUS_URI=http://localhost:19530

# --- VLM: САМОЕ ВАЖНОЕ ---
# Модель unsloth/gemma-4-12b-it НЕ доступна через api.openai.com —
# её обслуживает локальный OpenAI-совместимый сервер (vLLM / Ollama / LM Studio).
# VLM_ENGINE=openai означает «формат API — OpenAI-compatible», а URL должен
# указывать на ВАШ vLLM-сервер:
VLM_MODEL=unsloth/gemma-4-12b-it
VLM_QUANTIZATION=awq-4bit
VLM_ENGINE=openai

# vLLM запущен на этой же машине:
VLM_API_URL=http://localhost:8001/v1        # <-- ПРОВЕРИТЬ: порт/хост вашего vLLM
VLM_API_KEY=                                # vLLM обычно без ключа (оставить пустым);
                                            # если прокси требует — вписать
# Примеры альтернатив:
#   vLLM в docker с проброшенным портом: http://localhost:8001/v1
#   vLLM в docker-сети (имя сервиса):    http://vllm:8001/v1
#   Ollama:                               http://localhost:11434/v1
#   OpenAI (только если модель там реально есть): https://api.openai.com/v1 + ключ

VLM_DEVICE=cuda
MAX_CONTEXT_WINDOW=8192
IMAGE_WIDTH=768
VRAM_LIMIT_GB=16
EMPTY_CACHE_AFTER_PAGE=true
MAX_CONCURRENT_VLM=1

# --- OCR ---
# easyocr требует установленного пакета (torch!). Если не установлен —
# ставьте mock: OCR_ENGINE=mock (проверка будет работать с ручным вводом текста)
OCR_ENGINE=easyocr                          # easyocr | paddleocr | mock

# --- Storage ---
STORAGE_PATH=./storage
GOSTS_PATH=./storage/gosts
GALLERY_PATH=./storage/gallery

# --- Auth / RBAC ---
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
KOSEVEN_ENABLED=false
KOSEVEN_DB_DSN=
KOSEVEN_TABLE=koseven_users

# --- MCP ---
MCP_ENABLED=true

# --- CORS ---
CORS_ORIGINS=*                              # в проде: список конкретных origin

# --- Logging ---
LOG_LEVEL=INFO
# если в приложении есть настройка файла логов — укажите:
# LOG_FILE=./logs/normoscan.log

# ============================================================================
# ЧЕК-ЛИСТ если «Запустить проверку» не работает:
#   1. curl -s http://localhost:8001/v1/models        -> vLLM отвечает? Модель
#      называется ровно unsloth/gemma-4-12b-it (или как задано --served-model-name)?
#   2. curl -s http://localhost:8502/health           -> API жив?
#   3. redis-cli ping                                 -> Redis жив (если Celery)?
#   4. OCR_ENGINE=mock на время отладки — чтобы исключить easyocr.
#   5. Смотреть ЛОГИ приложения (LOG_LEVEL=INFO) — там будет причина.
# ============================================================================
