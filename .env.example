# ================= AviaProofAI =================
# Скопируйте в .env и поправьте под своё окружение.

# --- HTTP API (для Koseven и отладки) ---
API_HOST=0.0.0.0
API_PORT=8080
# Ключи доступа к REST API (через заголовок X-Api-Key), через запятую.
API_KEYS=dev-key-change-me

# --- PostgreSQL ---
# Пример для Docker (docker-compose.yml): postgresql+psycopg2://avia:avia@localhost:5432/avia
# Пример для локального PG:            postgresql+psycopg2://user:pass@localhost:5432/avia
DATABASE_URL=postgresql+psycopg2://avia:avia@localhost:5432/avia

# --- Teamcenter 11 ---
TC_URL=http://org-tc2:8080/tc/services/
TC_USER=infodba
TC_PASSWORD=infodba
TC_SPEC_ID=SPEC-BRAKE-001
# Протокол: rest (RestServices + cookie ASP.NET_SessionId — как в рабочем
# PHP-клиенте заказчика) или soap (AuthenticationToken в SOAP-Header).
TC_PROTOCOL=rest
# Способ авторизации REST:
#   json    — JsonRestServices/Core-2011-06-Session/login (проверенный
#             формат PHP-клиента заказчика; по умолчанию)
#   xml     — RestServices/Core-2007-01-Session/login (XML-конверт)
#   session — использовать готовую сессию из TC_SESSION_ID (например,
#             полученную PHP-клиентом)
TC_AUTH=json
# Готовая REST-сессия, если получена извне (как в PHP: ASP.NET_SessionId)
TC_SESSION_ID=
# Таймауты и устойчивость
TC_TIMEOUT=60            # чтение ответа, сек
TC_CONNECT_TIMEOUT=10    # установка соединения, сек
TC_RETRIES=2             # ретраи сетевых ошибок/5xx (backoff 0.5s, 1s)
TC_PAGE_SIZE=500         # пагинация getChildren (большие спецификации)
TC_VERIFY_SSL=true
TC_MAX_CONTENT_BYTES=10485760   # лимит файла контента датасета (10 МБ)
TC_ALLOW_EXTERNAL_FILES=false   # ticket на чужой хост запрещён (защита от SSRF)

# --- Запись в Teamcenter ---
# Глобальный выключатель ЗАПИСИ в Teamcenter. По умолчанию ВЫКЛЮЧЕНА (безопасно):
# сервис умеет только читать, пока администратор явно не включит запись.
# Включить: TC_WRITE_ALLOWED=true (также можно менять через API и БД).
TC_WRITE_ALLOWED=false

# --- LLM (OpenAI-совместимый endpoint: OpenAI, vLLM, Ollama, LM Studio...) ---
# Пусто -> используется встроенный эвристический движок (без сети), удобно для демо и тестов.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Для Ollama, например: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b
# Для локального vLLM:  LLM_BASE_URL=http://localhost:8000/v1

# --- Заглушка Teamcenter (stub_tc) ---
# Запуск:  uvicorn stub_tc.server:app --port 9080
# Адрес заглушки должен совпадать с TC_URL, если тестируете на ней:
# TC_URL=http://127.0.0.1:9080/tc/services/
STUB_PORT=9080
STUB_FIXTURE=stub_tc/fixtures/brake_system.yaml
